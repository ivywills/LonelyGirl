# dependencies
/node_modules

# next.js
/.next/
/out/

# production
# Ignore the contents rather than the directory itself: electron-builder reads
# its icon source from build/, and git can't re-include a file whose parent
# directory is excluded.
/build/*
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files — never commit secrets
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# desktop packaging output
/dist-desktop

# generated by `npm run desktop:build` before packaging
/.next/standalone
