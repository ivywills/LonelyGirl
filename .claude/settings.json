{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(psql *)",
      "Bash(/opt/homebrew/opt/libpq/bin/psql *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(brew install *)"
    ],
    "ask": [
      "Bash(psql * -c drop*)",
      "Bash(psql * -c truncate*)",
      "Bash(psql * -c delete*)",
      "Bash(/opt/homebrew/opt/libpq/bin/psql * -c drop*)",
      "Bash(/opt/homebrew/opt/libpq/bin/psql * -c truncate*)",
      "Bash(/opt/homebrew/opt/libpq/bin/psql * -c delete*)"
    ]
  }
}
