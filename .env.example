# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Running migrations (supabase/*.sql) without the dashboard ---
# Supabase → Project Settings → Database → Connection string. Holds the database
# password, so it lives in .env.local only — never commit it. The anon key above
# cannot run DDL, which is why this is separate.
#
# Use the SESSION POOLER string (port 5432, user postgres.<ref>), NOT the direct
# "db.<ref>.supabase.co" one: direct connections are IPv6-only and most home
# networks can't reach them. Port 6543 is transaction mode and won't run DDL.
SUPABASE_DB_URL_DEV=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Mobile app (required before `npm run mobile:sync`) ---
# The phone can't run the Next server, so the iOS/Android shells load the
# deployed site. Baked into the native projects at sync time, not at runtime —
# change it and re-run mobile:sync. The desktop app ignores this: it ships and
# runs its own copy of the server on localhost:43110.
LONELYGIRL_SERVER_URL=https://your-deployment.example.com

# --- Shopify merch store (optional — /shop shows previews until these are set) ---
# From Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app → Storefront API → enable unauthenticated_read_product_listings.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
