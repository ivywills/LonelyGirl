# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Mobile app (required before `npm run mobile:sync`) ---
# The phone can't run the Next server, so the iOS/Android shells load the
# deployed site. Baked into the native projects at sync time, not at runtime —
# change it and re-run mobile:sync. The desktop app ignores this: it ships and
# runs its own copy of the server on localhost:43110.
LONELYGIRL_SERVER_URL=https://your-deployment.example.com

# --- Shopify merch store (optional — /shop shows previews until these are set) ---
# From Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app → Storefront API → enable unauthenticated_read_product_listings.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
